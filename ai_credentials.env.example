# =============================================================================
# Account Research - AI / retrieval provider configuration
# =============================================================================
#
# This file is the CHECKLIST. It is committed and must never contain a value.
#
#   ai_credentials.env          real values, LOCAL ONLY, git-ignored, never committed
#   ai_credentials.env.example  this file: names, purpose and where each is needed
#   Render Environment          the same variable names, set directly on the service
#
# Application code reads os.environ / process.env. Locally those variables are
# populated from ai_credentials.env; in production Render supplies them directly,
# so nothing deployed requires this file to exist on disk.
#
# Copy to ai_credentials.env and fill in the values there:
#     cp ai_credentials.env.example ai_credentials.env
#
# LEGEND
#   [SECRET] a real credential. Rotate if exposed. Never commit, never log.
#   [CONFIG] not secret: an endpoint, a model name, an id or a flag.
#   Local / Render columns say where each one actually has to be set.
#
# =============================================================================


# --- Alibaba Cloud Model Studio (DashScope / Bailian) ------------------------

DASHSCOPE_API_KEY=
# [SECRET] Primary provider credential. Authenticates every model call, and
# also the Alibaba-hosted Tavily MCP endpoint.
# REQUIRED.  Local: yes.  Render: yes (set manually, never in render.yaml).

DASHSCOPE_BASE_URL=
# [CONFIG] Base URL the engine calls. Region-specific, so it is deployment
# configuration rather than a default.
# REQUIRED.  Local: yes.  Render: yes.

DASHSCOPE_WORKSPACE_ID=
# [CONFIG] Workspace identifier. Used to build the native and MCP hostnames.
# Not a credential, but it identifies the account.
# REQUIRED for the native protocol and for Tavily MCP.  Local: yes.  Render: yes.

DASHSCOPE_REGION=
# [CONFIG] Informational only. Routing uses DASHSCOPE_BASE_URL.
# OPTIONAL.  Local: optional.  Render: optional.

DASHSCOPE_PATH_TEXT=
# [CONFIG] Text-generation path on the native protocol.
# REQUIRED.  Local: yes.  Render: yes (render.yaml carries a default).

DASHSCOPE_PATH_MULTIMODAL=
# [CONFIG] Multimodal-generation path on the native protocol.
# REQUIRED.  Local: yes.  Render: yes (render.yaml carries a default).

DASHSCOPE_MULTIMODAL_MODELS=
# [CONFIG] Which model ids must use the multimodal endpoint.
# OPTIONAL.  Local: optional.  Render: optional (render.yaml carries a default).

TOKEN_PLAN_API_KEY=
# [SECRET] TokenPlan credential. Required for the OpenAI-compatible and
# Anthropic-compatible endpoints and for model listing; the native DashScope
# protocol does not use it.
# OPTIONAL for the deployed engine.  Local: yes.  Render: only if a
# compatible-mode endpoint is ever used in production.

TOKEN_PLAN_BASE_URL=
# [CONFIG] Base URL for the TokenPlan / compatible-mode endpoints.
# OPTIONAL.  Local: optional.  Render: optional.


# --- Retrieval providers ----------------------------------------------------

TAVILY_MCP_URL=
# [CONFIG] Full SSE endpoint of the Alibaba-hosted Tavily MCP server. Derived
# from DASHSCOPE_WORKSPACE_ID when unset, so it only needs setting to override.
# OPTIONAL.  Local: optional.  Render: NOT YET - Tavily is not integrated.

TAVILY_API_KEY=
# [SECRET] Only for a future direct-to-Tavily path. The Alibaba-hosted MCP
# authenticates with DASHSCOPE_API_KEY, so this is unset today.
# OPTIONAL.  Local: no.  Render: no.


# --- Model selection --------------------------------------------------------

AI_MODEL_QUALITY=
# [CONFIG] Model for final synthesis.
# OPTIONAL.  Local: optional.  Render: yes (render.yaml carries a default).

AI_MODEL_FAST=
# [CONFIG] Model for retrieval and cheaper calls.
# OPTIONAL.  Local: optional.  Render: yes (render.yaml carries a default).

AI_MODEL_CITATION=
# [CONFIG] Model used for citation handling.
# OPTIONAL.  Local: optional.  Render: yes (render.yaml carries a default).

AI_MODEL_FALLBACKS=
# [CONFIG] Comma-separated fallbacks tried when a model returns 403 AccessDenied.
# OPTIONAL.  Local: optional.  Render: optional.


# --- Retrieval and synthesis behaviour --------------------------------------

AI_SEARCH_ENABLED=
AI_SEARCH_STRATEGY=
AI_SOURCE_ENABLED=
AI_CITATION_ENABLED=
AI_CITATION_FORMAT=
AI_REQUEST_TIMEOUT_MS=
# [CONFIG] Retrieval and citation behaviour flags plus the request timeout.
# OPTIONAL.  Local: optional.  Render: yes (render.yaml carries defaults).


# --- Contact enrichment -----------------------------------------------------

APOLLO_API_KEY=
# [SECRET] Apollo credential. Contact enrichment degrades gracefully without it.
# OPTIONAL.  Local: optional.  Render: yes, if contact enrichment is wanted.

APOLLO_ENRICH_LIMIT=
# [CONFIG] Maximum contacts enriched per run.
# OPTIONAL.  Local: optional.  Render: optional (render.yaml carries a default).


# --- Engine access control --------------------------------------------------
# Not AI provider credentials, but the engine will not serve without them.

APP_ACCESS_USERNAME=
APP_ACCESS_PASSWORD=
# [SECRET] Browser login for the engine's own UI. Unset disables the gate,
# which is acceptable locally and never in production.
# REQUIRED in production.  Local: optional.  Render: yes.

APP_ACCESS_SECRET=
# [SECRET] Session-signing secret. Derived from the password when unset.
# OPTIONAL.  Local: no.  Render: recommended.

APP_SERVICE_KEY=
# [SECRET] Shared key for the CRM's server-to-server callback. Must match
# ACCOUNT_RESEARCH_SERVICE_KEY on the CRM service.
# REQUIRED in production.  Local: only when testing the callback.  Render: yes.

ALLOWED_FRAME_ANCESTORS=
# [CONFIG] Origins permitted to embed the engine UI.
# OPTIONAL.  Local: no.  Render: yes, when the CRM embeds the engine.


# --- Cost reporting ---------------------------------------------------------

AI_PRICE_INPUT_PER_1K=
AI_PRICE_OUTPUT_PER_1K=
AI_PRICE_CURRENCY=
# [CONFIG] Per-1K token prices for cost reporting. Omit all three and the engine
# reports "pricing not configured" rather than guessing.
# OPTIONAL.  Local: optional.  Render: optional.
