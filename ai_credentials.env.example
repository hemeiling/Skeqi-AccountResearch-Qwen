# =============================================================================
# AI Credentials & Model Configuration — 阿里云百炼 / Alibaba Bailian (DashScope)
# =============================================================================
# Consolidated from the completed model-search benchmark project.
# Source of truth: 'Qwen API Search 测试用例' (.env + config.js), verified 2026-09-01.
#
# TEMPLATE ONLY — safe to commit. Copy to ai_credentials.env and fill in
# the real values. Never put real keys in this file.
#
# NOTE: this file is a package of already-proven values. No benchmark was rerun
# to produce it, and no Account Research integration has been performed.
# =============================================================================

# -----------------------------------------------------------------------------
# Alibaba Bailian / DashScope
# -----------------------------------------------------------------------------
# Region: 华北 2（北京）· cn-beijing
# The pay-as-you-go key (sk-ws-) is REQUIRED for the DashScope native protocol.
# A Token Plan key (sk-sp-) returns 401 on the native endpoint — verified.
DASHSCOPE_API_KEY=sk-ws-REPLACE_WITH_PAY_AS_YOU_GO_KEY
DASHSCOPE_WORKSPACE_ID=ws-xxxxxxxxxxxxxxxx

# Native base URL is derived from the workspace id:
#   https://ws-xxxxxxxxxxxxxxxx.cn-beijing.maas.aliyuncs.com/api/v1
DASHSCOPE_BASE_URL=https://ws-xxxxxxxxxxxxxxxx.cn-beijing.maas.aliyuncs.com/api/v1
DASHSCOPE_REGION=cn-beijing

# Optional — only for the OpenAI/Anthropic-compatible endpoints.
# NOT needed for the recommended production path: those protocols accept
# enable_search but never return a source list, so citations are impossible.
TOKEN_PLAN_API_KEY=sk-sp-REPLACE_WITH_TOKEN_PLAN_KEY
TOKEN_PLAN_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# -----------------------------------------------------------------------------
# Tested production models
# -----------------------------------------------------------------------------
# All three verified to return 10/10 grounded sources on DashScope native.
AI_MODEL_QUALITY=deepseek-v4-pro
AI_MODEL_FAST=deepseek-v4-flash-0731
AI_MODEL_CITATION=qwen3.6-flash

# Extra model ids to fall back to when a configured model returns
#   403 AccessDenied.Unpurchased  "Access to model denied..."
# Comma-separated, tried in order after the three above, for BOTH retrieval and
# synthesis. Endpoint routing for unlisted ids is detected automatically.
# Check what this account can actually call:  GET /api/models/health?probe=1
AI_MODEL_FALLBACKS=

# -----------------------------------------------------------------------------
# REQUIRED ENDPOINT ROUTING  (getting this wrong returns 400 'url error')
# -----------------------------------------------------------------------------
#   deepseek-v4-pro         -> DashScope native / text-generation
#   deepseek-v4-flash-0731  -> DashScope native / text-generation
#   qwen3.6-flash           -> DashScope native / multimodal-generation
#
# Endpoint paths (appended to DASHSCOPE_BASE_URL):
DASHSCOPE_PATH_TEXT=/services/aigc/text-generation/generation
DASHSCOPE_PATH_MULTIMODAL=/services/aigc/multimodal-generation/generation

# Comma-separated models that MUST use the multimodal endpoint:
DASHSCOPE_MULTIMODAL_MODELS=qwen3.6-flash,qwen3.7-plus,qwen3.8-max,qwen3.8-flash

# Request-shape differences for the multimodal endpoint:
#   - messages content must be an ARRAY: content: [{ text: "..." }]
#   - do NOT send parameters.result_format
#   - response content comes back as an ARRAY of { text } parts
# text-generation uses plain string content and parameters.result_format="message".

# -----------------------------------------------------------------------------
# Search configuration
# -----------------------------------------------------------------------------
AI_SEARCH_STRATEGY=turbo
AI_SEARCH_ENABLED=true
AI_SOURCE_ENABLED=true
AI_CITATION_ENABLED=true
AI_CITATION_FORMAT=[<number>]

# Timeout: measured p95 ≈ 28s; 60s truncated real work during benchmarking.
AI_REQUEST_TIMEOUT_MS=90000

# -----------------------------------------------------------------------------
# KNOWN-BAD SETTINGS — verified failures, do not enable
# -----------------------------------------------------------------------------
#   search_options.freshness=7  -> collapses 10 sources to 0-1. Leave unset.
#   search_strategy=agent       -> 400 'Non-streaming mode does not support
#                                  Web Search in thinking mode' unless streaming.
#   glm-5.2                     -> 400 'This model does not support enable_search'
#                                  on every protocol. No web search. Do not use.
#   Anthropic-compatible proto  -> accepts enable_search, silently never searches.
#   qwen3.8-max / qwen3.8-flash -> frequent 504 even when sources return.
#
# Retrieval note: the source list is identical across models for a given query —
# one shared Alibaba search backend. The model only affects how well results are
# USED, not which results come back.

# -----------------------------------------------------------------------------
# Apollo — OPTIONAL people enrichment for the Key Decision Makers section
# -----------------------------------------------------------------------------
# Supplements web research with procurement, sourcing, manufacturing, automation
# and battery-engineering contacts that are hard to find on public pages.
# Read server-side only; never sent to the browser and never written to a report.
# Leave unset to run web-only research — Apollo is never required.
#
# Two stages, so credits are only spent on people worth contacting:
#   1. mixed_people/search   broad candidate list, no credit cost
#   2. people/bulk_match     business email reveal — THIS is the credit spend
# Only the top-ranked contacts reach stage 2.
APOLLO_API_KEY=

# How many ranked contacts to enrich per company (stage 2). Default 12, max 25.
# Each enriched contact costs one Apollo credit, so raise this deliberately.
APOLLO_ENRICH_LIMIT=12

# -----------------------------------------------------------------------------
# Deployment: access gate and embedding  (set as ENV VARS on the host)
# -----------------------------------------------------------------------------
# When this app is reachable from the public internet these two are what stand
# between anonymous visitors and every saved report, PDF and Apollo contact.
# Leave BOTH unset for local development and the gate stays off.
# A login form (not HTTP Basic) is used, because browsers suppress Basic-auth
# prompts inside the cross-origin iframe the CRM embeds this app in.
APP_ACCESS_USERNAME=
APP_ACCESS_PASSWORD=
# Optional. Defaults to a value derived from the password, so changing the
# password already invalidates existing sessions.
APP_ACCESS_SECRET=

# Shared secret for server-to-server calls from the CRM backend. When set, a
# request carrying  X-AR-Service-Key: <this value>  bypasses the login form.
# It never reaches a browser. Must match ACCOUNT_RESEARCH_SERVICE_KEY in the CRM.
APP_SERVICE_KEY=

# Origins allowed to embed this app in an iframe, space-separated.
# Scheme + host, no trailing path. NEVER use "*".
#   e.g. https://skeqi-emaildrafter.onrender.com
ALLOWED_FRAME_ANCESTORS=
